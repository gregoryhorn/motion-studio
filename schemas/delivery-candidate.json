{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "motion/v1/CandidateRecord",
  "type": "object",
  "properties": {
    "schema": {
      "const": "motion/v1/candidate"
    },
    "artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "project_id": {
      "type": "string",
      "minLength": 0,
      "maxLength": 16384,
      "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "project_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "plan": {
      "$ref": "#/$defs/PlanRef"
    },
    "variant_id": {
      "type": "string",
      "minLength": 0,
      "maxLength": 16384,
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "variant": {
      "$ref": "#/$defs/DocumentRef"
    },
    "sidecars": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SidecarRecord"
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "dependencies_sha256": {
      "type": "string",
      "minLength": 0,
      "maxLength": 16384,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "gate_policy": {
      "$ref": "#/$defs/DocumentRef"
    },
    "job_id": {
      "type": "string",
      "minLength": 0,
      "maxLength": 16384,
      "pattern": "^job_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "created_at": {
      "type": "string",
      "minLength": 0,
      "maxLength": 16384,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    }
  },
  "required": [
    "schema",
    "artifact",
    "project_id",
    "project_revision",
    "plan",
    "variant_id",
    "variant",
    "sidecars",
    "dependencies_sha256",
    "gate_policy",
    "job_id",
    "created_at"
  ],
  "additionalProperties": false,
  "$defs": {
    "ArtifactRef": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^art_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "sha256": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "artifact_id",
        "sha256"
      ],
      "additionalProperties": false
    },
    "PlanRef": {
      "type": "object",
      "properties": {
        "plan_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^pln_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "plan_revision": {
          "const": 1
        },
        "plan_sha256": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "plan_id",
        "plan_revision",
        "plan_sha256"
      ],
      "additionalProperties": false
    },
    "DocumentRef": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "brief",
            "brand",
            "timeline",
            "scene",
            "settings",
            "variants",
            "bindings",
            "caption",
            "caption_style",
            "delivery_profile",
            "gate_policy",
            "asset_library",
            "storyboard"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "kind",
        "id",
        "revision",
        "sha256"
      ],
      "additionalProperties": false
    },
    "SidecarRecord": {
      "type": "object",
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "role": {
          "const": "subtitles"
        },
        "variant": {
          "$ref": "#/$defs/DocumentRef"
        },
        "caption": {
          "$ref": "#/$defs/DocumentRef"
        },
        "placement": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "format": {
          "type": "string",
          "enum": [
            "srt",
            "vtt",
            "ass"
          ]
        },
        "time_origin": {
          "type": "string",
          "enum": [
            "source",
            "delivery"
          ]
        },
        "timing_receipt": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "artifact",
        "role",
        "variant",
        "caption",
        "placement",
        "language",
        "format",
        "time_origin",
        "timing_receipt"
      ],
      "additionalProperties": false
    }
  }
}
