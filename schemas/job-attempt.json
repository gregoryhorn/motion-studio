{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "motion/v1/job-attempt",
  "type": "object",
  "properties": {
    "schema": {
      "const": "motion/v1/attempt"
    },
    "attempt_id": {
      "type": "string",
      "minLength": 0,
      "maxLength": 16384,
      "pattern": "^att_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "job_id": {
      "type": "string",
      "minLength": 0,
      "maxLength": 16384,
      "pattern": "^job_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "node_id": {
      "type": "string",
      "minLength": 0,
      "maxLength": 16384,
      "pattern": "^nod_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "attempt_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "request_sha256": {
      "type": "string",
      "minLength": 0,
      "maxLength": 16384,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "started_at": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
        },
        {
          "type": "null"
        }
      ]
    },
    "ended_at": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
        },
        {
          "type": "null"
        }
      ]
    },
    "owner": {
      "type": "object",
      "properties": {
        "worker_token": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384
        },
        "pid": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "process_started_at": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 16384
            },
            {
              "type": "null"
            }
          ]
        },
        "boot_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 16384
            },
            {
              "type": "null"
            }
          ]
        },
        "lease_expires_at": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
        }
      },
      "required": [
        "worker_token",
        "pid",
        "process_started_at",
        "boot_id",
        "lease_expires_at"
      ],
      "additionalProperties": false
    },
    "submission_state": {
      "type": "string",
      "enum": [
        "not_sent",
        "intent_recorded",
        "confirmed",
        "uncertain"
      ]
    },
    "provider_request_key": {
      "type": "string",
      "minLength": 0,
      "maxLength": 16384
    },
    "external_handle": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384
        },
        {
          "type": "null"
        }
      ]
    },
    "remote_state": {
      "type": "string",
      "enum": [
        "none",
        "running",
        "succeeded",
        "failed",
        "cancelled",
        "unknown"
      ]
    },
    "output_dir": {
      "type": "string",
      "minLength": 0,
      "maxLength": 16384
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 0,
              "maxLength": 16384
            },
            "message": {
              "type": "string",
              "minLength": 0,
              "maxLength": 16384
            },
            "details": {
              "type": "object"
            },
            "retry": {
              "type": "string",
              "enum": [
                "never",
                "after_input_change",
                "after_authority",
                "after_dependency",
                "after_reconcile",
                "same_request"
              ]
            },
            "effect": {
              "type": "string",
              "enum": [
                "none",
                "committed",
                "partial",
                "unknown"
              ]
            },
            "logs_ref": {
              "type": "object",
              "properties": {
                "artifact_id": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 16384,
                  "pattern": "^art_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "sha256": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 16384,
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              },
              "required": [
                "artifact_id",
                "sha256"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "code",
            "message",
            "details",
            "retry",
            "effect"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema",
    "attempt_id",
    "job_id",
    "node_id",
    "attempt_number",
    "request_sha256",
    "started_at",
    "ended_at",
    "owner",
    "submission_state",
    "provider_request_key",
    "external_handle",
    "remote_state",
    "output_dir",
    "error"
  ],
  "additionalProperties": false
}
