{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "motion/v1/PackageManifest",
  "type": "object",
  "properties": {
    "schema": {
      "const": "motion/v1/package-manifest"
    },
    "members": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PackageMember"
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "runtime_requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RuntimeIdentity"
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "reproduction": {
      "type": "object",
      "properties": {
        "assembly_plan": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "generation_boundary": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384
        },
        "expected_equivalence": {
          "type": "string",
          "enum": [
            "bytes",
            "content_and_format"
          ]
        }
      },
      "required": [
        "assembly_plan",
        "generation_boundary",
        "expected_equivalence"
      ],
      "additionalProperties": false
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 0,
            "maxLength": 16384
          },
          "artifact_id": {
            "type": "string",
            "minLength": 0,
            "maxLength": 16384,
            "pattern": "^art_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        },
        "required": [
          "reason",
          "artifact_id"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000
    }
  },
  "required": [
    "schema",
    "members",
    "runtime_requirements",
    "reproduction",
    "exclusions"
  ],
  "additionalProperties": false,
  "$defs": {
    "PackageMember": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "role": {
          "type": "string",
          "enum": [
            "master",
            "sidecar",
            "source",
            "asset",
            "font",
            "provenance",
            "instructions"
          ]
        }
      },
      "required": [
        "path",
        "artifact",
        "role"
      ],
      "additionalProperties": false
    },
    "ArtifactRef": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^art_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "sha256": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "artifact_id",
        "sha256"
      ],
      "additionalProperties": false
    },
    "RuntimeIdentity": {
      "type": "object",
      "properties": {
        "adapter_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
        },
        "implementation_version": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384
        },
        "engine": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384
        },
        "engine_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 16384
            },
            {
              "type": "null"
            }
          ]
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "minItems": 0,
          "maxItems": 1000
        },
        "entry_member": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        }
      },
      "required": [
        "adapter_id",
        "implementation_version",
        "engine",
        "engine_version",
        "dependencies",
        "entry_member"
      ],
      "additionalProperties": false
    }
  }
}
