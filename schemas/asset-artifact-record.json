{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "motion/v1/ArtifactRecord",
  "type": "object",
  "properties": {
    "schema": {
      "const": "motion/v1/artifact"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 0,
      "maxLength": 16384,
      "pattern": "^art_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "project_id": {
      "type": "string",
      "minLength": 0,
      "maxLength": 16384,
      "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "media",
        "image",
        "audio",
        "frame",
        "caption",
        "caption_style",
        "scene_source",
        "assembly_source",
        "json",
        "report",
        "archive",
        "font"
      ]
    },
    "media_type": {
      "type": "string",
      "minLength": 0,
      "maxLength": 16384
    },
    "sha256": {
      "type": "string",
      "minLength": 0,
      "maxLength": 16384,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "storage": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "managed"
            },
            "relative_path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            }
          },
          "required": [
            "mode",
            "relative_path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "external"
            },
            "source": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "local"
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16384
                }
              },
              "required": [
                "kind",
                "path"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "mode",
            "source"
          ],
          "additionalProperties": false
        }
      ]
    },
    "created_at": {
      "type": "string",
      "minLength": 0,
      "maxLength": 16384,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    },
    "producer": {
      "type": "object",
      "properties": {
        "job_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 16384,
              "pattern": "^job_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "node_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 16384,
              "pattern": "^nod_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "attempt_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 16384,
              "pattern": "^att_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "adapter_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "job_id",
        "node_id",
        "attempt_id",
        "adapter_id"
      ],
      "additionalProperties": false
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "probe_receipt_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^rcp_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema",
    "artifact_id",
    "project_id",
    "kind",
    "media_type",
    "sha256",
    "size_bytes",
    "storage",
    "created_at",
    "producer",
    "inputs",
    "provenance",
    "probe_receipt_id"
  ],
  "additionalProperties": false,
  "$defs": {
    "ArtifactRef": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^art_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "sha256": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "artifact_id",
        "sha256"
      ],
      "additionalProperties": false
    },
    "Provenance": {
      "type": "object",
      "properties": {
        "origin": {
          "type": "string",
          "enum": [
            "user_import",
            "authored",
            "stock",
            "generated",
            "derived"
          ]
        },
        "acquired_at": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
        },
        "source_locator": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 16384
            },
            {
              "type": "null"
            }
          ]
        },
        "provider": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 16384
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 16384
            },
            {
              "type": "null"
            }
          ]
        },
        "model_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 16384
            },
            {
              "type": "null"
            }
          ]
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "deterministic": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "rights": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "known",
                "unknown",
                "restricted"
              ]
            },
            "license": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 16384
                },
                {
                  "type": "null"
                }
              ]
            },
            "attribution": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 16384
                },
                {
                  "type": "null"
                }
              ]
            },
            "evidence": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ArtifactRef"
              },
              "minItems": 0,
              "maxItems": 1000
            }
          },
          "required": [
            "status",
            "license",
            "attribution",
            "evidence"
          ],
          "additionalProperties": false
        },
        "notes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384
        }
      },
      "required": [
        "origin",
        "acquired_at",
        "source_locator",
        "provider",
        "model",
        "model_version",
        "seed",
        "deterministic",
        "rights",
        "notes"
      ],
      "additionalProperties": false
    }
  }
}
