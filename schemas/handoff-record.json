{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "motion/v1/handoff-record",
  "type": "object",
  "properties": {
    "handoff_id": {
      "type": "string",
      "minLength": 0,
      "maxLength": 16384,
      "pattern": "^hnd_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "job_id": {
      "type": "string",
      "minLength": 0,
      "maxLength": 16384,
      "pattern": "^job_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "node_id": {
      "type": "string",
      "minLength": 0,
      "maxLength": 16384,
      "pattern": "^nod_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "attempt_id": {
      "type": "string",
      "minLength": 0,
      "maxLength": 16384,
      "pattern": "^att_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "request_sha256": {
      "type": "string",
      "minLength": 0,
      "maxLength": 16384,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "host_tool",
        "gui"
      ]
    },
    "tool_name": {
      "type": "string",
      "minLength": 0,
      "maxLength": 16384
    },
    "tool_schema_sha256": {
      "type": "string",
      "minLength": 0,
      "maxLength": 16384,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "arguments": {
      "type": "object"
    },
    "expected_outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "port": {
            "type": "string",
            "minLength": 0,
            "maxLength": 16384
          },
          "kind": {
            "type": "string",
            "enum": [
              "media",
              "image",
              "audio",
              "frame",
              "caption",
              "caption_style",
              "scene_source",
              "assembly_source",
              "json",
              "report",
              "archive",
              "font"
            ]
          },
          "media_type": {
            "type": "string",
            "minLength": 0,
            "maxLength": 16384
          }
        },
        "required": [
          "port",
          "kind",
          "media_type"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "effects": {
      "type": "object",
      "properties": {
        "writes_local": {
          "type": "boolean"
        },
        "uploads": {
          "type": "boolean"
        },
        "destinations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 16384
          },
          "minItems": 0,
          "maxItems": 1000
        },
        "generates": {
          "type": "boolean"
        },
        "launches_process": {
          "type": "boolean"
        },
        "pricing": {
          "type": "string",
          "enum": [
            "free",
            "metered",
            "subscription",
            "unknown"
          ]
        },
        "charging_basis": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 16384
            },
            {
              "type": "null"
            }
          ]
        },
        "estimate": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "amount": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 16384
                },
                "currency": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 16384
                },
                "source": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 16384
                }
              },
              "required": [
                "amount",
                "currency",
                "source"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "writes_local",
        "uploads",
        "destinations",
        "generates",
        "launches_process",
        "pricing",
        "charging_basis",
        "estimate"
      ],
      "additionalProperties": false
    },
    "state": {
      "type": "string",
      "enum": [
        "ready",
        "claimed",
        "reported",
        "validated",
        "uncertain"
      ]
    },
    "claimed_by": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "system",
                "agent",
                "user"
              ]
            },
            "actor_ref": {
              "type": "string",
              "minLength": 0,
              "maxLength": 16384
            }
          },
          "required": [
            "kind",
            "actor_ref"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "host_call_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384
        },
        {
          "type": "null"
        }
      ]
    },
    "instructions": {
      "type": "string",
      "minLength": 0,
      "maxLength": 16384
    }
  },
  "required": [
    "handoff_id",
    "job_id",
    "node_id",
    "attempt_id",
    "request_sha256",
    "kind",
    "tool_name",
    "tool_schema_sha256",
    "arguments",
    "expected_outputs",
    "effects",
    "state",
    "claimed_by",
    "host_call_ref",
    "instructions"
  ],
  "additionalProperties": false
}
