{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "motion/v1/GateResult",
  "type": "object",
  "properties": {
    "gate": {
      "type": "string",
      "enum": [
        "creative",
        "technical",
        "art",
        "audio",
        "delivery_profile"
      ]
    },
    "result": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "review_needed",
        "not_applicable"
      ]
    },
    "freshness": {
      "type": "string",
      "enum": [
        "current",
        "stale"
      ]
    },
    "review_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 0,
        "maxLength": 16384,
        "pattern": "^rev_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      },
      "minItems": 0,
      "maxItems": 1000,
      "uniqueItems": true
    },
    "reason": {
      "type": "string",
      "minLength": 0,
      "maxLength": 16384
    }
  },
  "required": [
    "gate",
    "result",
    "freshness",
    "review_ids",
    "reason"
  ],
  "additionalProperties": false,
  "$defs": {}
}
