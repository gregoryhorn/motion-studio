{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "motion/v1/ReviewRequest",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "record"
        },
        "project_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "request_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "candidate": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "expected_candidate_manifest_sha256": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "gate": {
          "type": "string",
          "enum": [
            "creative",
            "technical",
            "art",
            "audio",
            "delivery_profile"
          ]
        },
        "result": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "review_needed",
            "not_applicable"
          ]
        },
        "method": {
          "type": "string",
          "enum": [
            "agent_visual",
            "agent_audio",
            "user",
            "playback"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "minItems": 0,
          "maxItems": 1000
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "minItems": 0,
          "maxItems": 1000
        },
        "reason": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384
        },
        "supersedes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^rev_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "action",
        "project_id",
        "request_id",
        "candidate",
        "expected_candidate_manifest_sha256",
        "gate",
        "result",
        "method",
        "evidence",
        "coverage",
        "findings",
        "reason"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "check"
        },
        "project_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "request_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "authority_ref": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384
        },
        "candidate": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "gates": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "creative",
              "technical",
              "art",
              "audio",
              "delivery_profile"
            ]
          },
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true
        },
        "adapter_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        }
      },
      "required": [
        "action",
        "project_id",
        "request_id",
        "expected_revision",
        "candidate",
        "gates",
        "adapter_id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "gates"
        },
        "project_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "candidate": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "action",
        "project_id",
        "candidate"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "inspect"
        },
        "project_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "review_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^rev_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "action",
        "project_id",
        "review_id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "list"
        },
        "project_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "cursor": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^snp_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "candidate": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "gate": {
          "type": "string",
          "enum": [
            "creative",
            "technical",
            "art",
            "audio",
            "delivery_profile"
          ]
        },
        "result": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "review_needed",
            "not_applicable"
          ]
        }
      },
      "required": [
        "action",
        "project_id"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "ArtifactRef": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^art_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "sha256": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "artifact_id",
        "sha256"
      ],
      "additionalProperties": false
    },
    "Coverage": {
      "type": "object",
      "properties": {
        "frame_ranges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "start_frame": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "end_frame": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "start_frame",
              "end_frame"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 1000
        },
        "sample_ranges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "start_sample": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "end_sample": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "sample_rate": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "start_sample",
              "end_sample",
              "sample_rate"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 1000
        },
        "scene_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 16384,
            "pattern": "^scn_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "minItems": 0,
          "maxItems": 1000,
          "uniqueItems": true
        },
        "transition_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 16384,
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "minItems": 0,
          "maxItems": 1000,
          "uniqueItems": true
        },
        "whole_decode": {
          "type": "boolean"
        },
        "playback": {
          "type": "string",
          "enum": [
            "not_tested",
            "pass",
            "fail"
          ]
        }
      },
      "required": [
        "frame_ranges",
        "sample_ranges",
        "scene_ids",
        "transition_keys",
        "whole_decode",
        "playback"
      ],
      "additionalProperties": false
    },
    "Finding": {
      "type": "object",
      "properties": {
        "finding_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "minor",
            "blocking"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384
        },
        "frame": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "sample": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "required_change": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 16384
            },
            {
              "type": "null"
            }
          ]
        },
        "resolution_receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "finding_id",
        "severity",
        "description",
        "frame",
        "sample",
        "required_change",
        "resolution_receipt"
      ],
      "additionalProperties": false
    }
  }
}
