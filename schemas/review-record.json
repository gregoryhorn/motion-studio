{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "motion/v1/ReviewRecord",
  "type": "object",
  "properties": {
    "schema": {
      "const": "motion/v1/review"
    },
    "review_id": {
      "type": "string",
      "minLength": 0,
      "maxLength": 16384,
      "pattern": "^rev_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "project_id": {
      "type": "string",
      "minLength": 0,
      "maxLength": 16384,
      "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "created_at": {
      "type": "string",
      "minLength": 0,
      "maxLength": 16384,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    },
    "subject": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "candidate_manifest_sha256": {
      "type": "string",
      "minLength": 0,
      "maxLength": 16384,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "subject_dependencies": {
      "type": "string",
      "minLength": 0,
      "maxLength": 16384,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "policy": {
      "$ref": "#/$defs/DocumentRef"
    },
    "gate": {
      "type": "string",
      "enum": [
        "creative",
        "technical",
        "art",
        "audio",
        "delivery_profile"
      ]
    },
    "result": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "review_needed",
        "not_applicable"
      ]
    },
    "method": {
      "type": "string",
      "enum": [
        "deterministic",
        "agent_visual",
        "agent_audio",
        "user",
        "playback"
      ]
    },
    "author": {
      "$ref": "#/$defs/Actor"
    },
    "tool": {
      "type": "string",
      "minLength": 0,
      "maxLength": 16384
    },
    "tool_version": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "measurements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Measurement"
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "coverage": {
      "$ref": "#/$defs/Coverage"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "reason": {
      "type": "string",
      "minLength": 0,
      "maxLength": 16384
    },
    "supersedes": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^rev_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema",
    "review_id",
    "project_id",
    "created_at",
    "subject",
    "candidate_manifest_sha256",
    "subject_dependencies",
    "policy",
    "gate",
    "result",
    "method",
    "author",
    "tool",
    "tool_version",
    "evidence",
    "measurements",
    "coverage",
    "findings",
    "reason",
    "supersedes"
  ],
  "additionalProperties": false,
  "$defs": {
    "ArtifactRef": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^art_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "sha256": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "artifact_id",
        "sha256"
      ],
      "additionalProperties": false
    },
    "DocumentRef": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "brief",
            "brand",
            "timeline",
            "scene",
            "settings",
            "variants",
            "bindings",
            "caption",
            "caption_style",
            "delivery_profile",
            "gate_policy",
            "asset_library",
            "storyboard"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "kind",
        "id",
        "revision",
        "sha256"
      ],
      "additionalProperties": false
    },
    "Actor": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "system",
            "agent",
            "user"
          ]
        },
        "actor_ref": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384
        }
      },
      "required": [
        "kind",
        "actor_ref"
      ],
      "additionalProperties": false
    },
    "Measurement": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384
        },
        "value": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^[+-]?[0-9]+(?:\\.[0-9]+)?$"
        },
        "unit": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384
        },
        "method": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384
        },
        "scope": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384
        }
      },
      "required": [
        "name",
        "value",
        "unit",
        "method",
        "scope"
      ],
      "additionalProperties": false
    },
    "Coverage": {
      "type": "object",
      "properties": {
        "frame_ranges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "start_frame": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "end_frame": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "start_frame",
              "end_frame"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 1000
        },
        "sample_ranges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "start_sample": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "end_sample": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "sample_rate": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "start_sample",
              "end_sample",
              "sample_rate"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 1000
        },
        "scene_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 16384,
            "pattern": "^scn_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "minItems": 0,
          "maxItems": 1000,
          "uniqueItems": true
        },
        "transition_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 16384,
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "minItems": 0,
          "maxItems": 1000,
          "uniqueItems": true
        },
        "whole_decode": {
          "type": "boolean"
        },
        "playback": {
          "type": "string",
          "enum": [
            "not_tested",
            "pass",
            "fail"
          ]
        }
      },
      "required": [
        "frame_ranges",
        "sample_ranges",
        "scene_ids",
        "transition_keys",
        "whole_decode",
        "playback"
      ],
      "additionalProperties": false
    },
    "Finding": {
      "type": "object",
      "properties": {
        "finding_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "minor",
            "blocking"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384
        },
        "frame": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "sample": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "required_change": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 16384
            },
            {
              "type": "null"
            }
          ]
        },
        "resolution_receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "finding_id",
        "severity",
        "description",
        "frame",
        "sample",
        "required_change",
        "resolution_receipt"
      ],
      "additionalProperties": false
    }
  }
}
