{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "motion/v1/DeliveryFile",
  "type": "object",
  "properties": {
    "artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "role": {
      "type": "string",
      "enum": [
        "master",
        "sidecar",
        "editable_package",
        "media_package",
        "report"
      ]
    },
    "filename": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "media_type": {
      "type": "string",
      "minLength": 0,
      "maxLength": 16384
    },
    "delivery_handle": {
      "type": "string",
      "minLength": 0,
      "maxLength": 16384
    },
    "verification": {
      "type": "string",
      "enum": [
        "verified",
        "draft",
        "incomplete"
      ]
    },
    "expires_at": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "artifact",
    "role",
    "filename",
    "size_bytes",
    "media_type",
    "delivery_handle",
    "verification",
    "expires_at"
  ],
  "additionalProperties": false,
  "$defs": {
    "ArtifactRef": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^art_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "sha256": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "artifact_id",
        "sha256"
      ],
      "additionalProperties": false
    }
  }
}
