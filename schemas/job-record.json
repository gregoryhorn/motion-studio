{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "motion/v1/job-record",
  "type": "object",
  "properties": {
    "schema": {
      "const": "motion/v1/job"
    },
    "job_id": {
      "type": "string",
      "minLength": 0,
      "maxLength": 16384,
      "pattern": "^job_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "project_id": {
      "type": "string",
      "minLength": 0,
      "maxLength": 16384,
      "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "project_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "job_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "plan": {
      "type": "object",
      "properties": {
        "plan_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^pln_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "plan_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "plan_sha256": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "plan_id",
        "plan_revision",
        "plan_sha256"
      ],
      "additionalProperties": false
    },
    "request_id": {
      "type": "string",
      "minLength": 0,
      "maxLength": 16384
    },
    "request_sha256": {
      "type": "string",
      "minLength": 0,
      "maxLength": 16384,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "created_at": {
      "type": "string",
      "minLength": 0,
      "maxLength": 16384,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    },
    "updated_at": {
      "type": "string",
      "minLength": 0,
      "maxLength": 16384,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    },
    "state": {
      "type": "string",
      "enum": [
        "planned",
        "queued",
        "running",
        "awaiting_external",
        "review_needed",
        "succeeded",
        "failed",
        "cancelled",
        "interrupted"
      ]
    },
    "node_states": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "node_id": {
            "type": "string",
            "minLength": 0,
            "maxLength": 16384,
            "pattern": "^nod_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "state": {
            "type": "string",
            "enum": [
              "planned",
              "queued",
              "running",
              "awaiting_external",
              "review_needed",
              "succeeded",
              "failed",
              "cancelled",
              "interrupted"
            ]
          },
          "attempt_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 0,
                "maxLength": 16384,
                "pattern": "^att_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "reused": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "artifact_id": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 16384,
                  "pattern": "^art_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "sha256": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 16384,
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              },
              "required": [
                "artifact_id",
                "sha256"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 1000
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "artifact_id": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 16384,
                  "pattern": "^art_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "sha256": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 16384,
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              },
              "required": [
                "artifact_id",
                "sha256"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 1000
          },
          "blocked_reason": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 0,
                "maxLength": 16384
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "node_id",
          "state",
          "attempt_id",
          "reused",
          "outputs",
          "blocked_reason"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "attempt_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 0,
        "maxLength": 16384,
        "pattern": "^att_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 0,
            "maxLength": 16384,
            "pattern": "^art_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "sha256": {
            "type": "string",
            "minLength": 0,
            "maxLength": 16384,
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "required": [
          "artifact_id",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "stale": {
      "type": "boolean"
    },
    "stale_reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 0,
        "maxLength": 16384
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "cancel": {
      "type": "object",
      "properties": {
        "requested": {
          "type": "boolean"
        },
        "requested_at": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 16384,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "disposition": {
          "type": "string",
          "enum": [
            "not_requested",
            "pending",
            "confirmed",
            "unsupported",
            "too_late",
            "unknown"
          ]
        },
        "external_may_continue": {
          "type": "boolean"
        }
      },
      "required": [
        "requested",
        "requested_at",
        "disposition",
        "external_may_continue"
      ],
      "additionalProperties": false
    },
    "submission_state": {
      "type": "string",
      "enum": [
        "not_sent",
        "intent_recorded",
        "confirmed",
        "uncertain"
      ]
    },
    "remote_state": {
      "type": "string",
      "enum": [
        "none",
        "running",
        "succeeded",
        "failed",
        "cancelled",
        "unknown"
      ]
    },
    "authority_evidence_ref": {
      "type": "string",
      "minLength": 0,
      "maxLength": 16384
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 0,
              "maxLength": 16384
            },
            "message": {
              "type": "string",
              "minLength": 0,
              "maxLength": 16384
            },
            "details": {
              "type": "object",
              "additionalProperties": {}
            },
            "retry": {
              "type": "string",
              "enum": [
                "never",
                "after_input_change",
                "after_authority",
                "after_dependency",
                "after_reconcile",
                "same_request"
              ]
            },
            "effect": {
              "type": "string",
              "enum": [
                "none",
                "committed",
                "partial",
                "unknown"
              ]
            },
            "logs_ref": {
              "type": "object",
              "properties": {
                "artifact_id": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 16384,
                  "pattern": "^art_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "sha256": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 16384,
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              },
              "required": [
                "artifact_id",
                "sha256"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "code",
            "message",
            "details",
            "retry",
            "effect"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema",
    "job_id",
    "project_id",
    "project_revision",
    "job_revision",
    "plan",
    "request_id",
    "request_sha256",
    "created_at",
    "updated_at",
    "state",
    "node_states",
    "attempt_ids",
    "outputs",
    "stale",
    "stale_reasons",
    "cancel",
    "submission_state",
    "remote_state",
    "authority_evidence_ref",
    "error"
  ],
  "additionalProperties": false
}
