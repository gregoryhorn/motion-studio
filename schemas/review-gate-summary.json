{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "motion/v1/GateSummary",
  "type": "object",
  "properties": {
    "candidate": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "candidate_manifest_sha256": {
      "type": "string",
      "minLength": 0,
      "maxLength": 16384,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "policy": {
      "$ref": "#/$defs/DocumentRef"
    },
    "gates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GateResult"
      },
      "minItems": 5,
      "maxItems": 1000
    },
    "promotion_eligible": {
      "type": "boolean"
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 0,
        "maxLength": 16384
      },
      "minItems": 0,
      "maxItems": 1000
    }
  },
  "required": [
    "candidate",
    "candidate_manifest_sha256",
    "policy",
    "gates",
    "promotion_eligible",
    "missing"
  ],
  "additionalProperties": false,
  "$defs": {
    "ArtifactRef": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^art_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "sha256": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "artifact_id",
        "sha256"
      ],
      "additionalProperties": false
    },
    "DocumentRef": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "brief",
            "brand",
            "timeline",
            "scene",
            "settings",
            "variants",
            "bindings",
            "caption",
            "caption_style",
            "delivery_profile",
            "gate_policy",
            "asset_library",
            "storyboard"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "kind",
        "id",
        "revision",
        "sha256"
      ],
      "additionalProperties": false
    },
    "GateResult": {
      "type": "object",
      "properties": {
        "gate": {
          "type": "string",
          "enum": [
            "creative",
            "technical",
            "art",
            "audio",
            "delivery_profile"
          ]
        },
        "result": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "review_needed",
            "not_applicable"
          ]
        },
        "freshness": {
          "type": "string",
          "enum": [
            "current",
            "stale"
          ]
        },
        "review_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 16384,
            "pattern": "^rev_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "minItems": 0,
          "maxItems": 1000,
          "uniqueItems": true
        },
        "reason": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384
        }
      },
      "required": [
        "gate",
        "result",
        "freshness",
        "review_ids",
        "reason"
      ],
      "additionalProperties": false
    }
  }
}
