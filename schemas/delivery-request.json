{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "motion/v1/DeliveryRequest",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "encode"
        },
        "project_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "request_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "authority_ref": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384
        },
        "variant_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 16384,
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "variant_id": {
                "type": "string",
                "minLength": 0,
                "maxLength": 16384,
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "media": {
                "$ref": "#/$defs/ArtifactRef"
              },
              "audio": {
                "$ref": "#/$defs/ArtifactRef"
              },
              "captions": {
                "$ref": "#/$defs/DocumentRef"
              },
              "placement": {
                "$ref": "#/$defs/ArtifactRef"
              },
              "timeline_item_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 16384,
                  "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                },
                "minItems": 1,
                "maxItems": 1000,
                "uniqueItems": true
              },
              "style": {
                "$ref": "#/$defs/DocumentRef"
              },
              "sidecars": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/SidecarRecord"
                },
                "minItems": 0,
                "maxItems": 1000
              }
            },
            "required": [
              "variant_id",
              "media"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 1000
        },
        "adapter_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
        },
        "encoder_options": {
          "$ref": "#/$defs/RegisteredOptions"
        }
      },
      "required": [
        "action",
        "project_id",
        "request_id",
        "expected_revision",
        "variant_ids",
        "inputs",
        "adapter_id",
        "encoder_options"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "validate"
        },
        "project_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "request_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "authority_ref": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true
        },
        "adapter_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
        }
      },
      "required": [
        "action",
        "project_id",
        "request_id",
        "expected_revision",
        "candidates",
        "adapter_id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "promote"
        },
        "project_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "request_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true
        },
        "expected_master_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "action",
        "project_id",
        "request_id",
        "expected_revision",
        "candidates",
        "expected_master_revision"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "status"
        },
        "project_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "cursor": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^snp_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "section": {
          "type": "string",
          "enum": [
            "summary",
            "candidates",
            "masters",
            "packages"
          ]
        },
        "variant_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        }
      },
      "required": [
        "action",
        "project_id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "files"
        },
        "project_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "cursor": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^snp_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "master_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 16384,
            "pattern": "^mst_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true
        },
        "package_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^pkg_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "action",
        "project_id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "package"
        },
        "project_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "request_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "authority_ref": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384
        },
        "master_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 16384,
            "pattern": "^mst_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true
        },
        "sidecars": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SidecarRecord"
          },
          "minItems": 0,
          "maxItems": 1000
        },
        "format": {
          "type": "string",
          "enum": [
            "zip",
            "tar"
          ]
        },
        "include_sources": {
          "type": "boolean"
        },
        "reconstruct": {
          "type": "boolean"
        },
        "adapter_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
        }
      },
      "required": [
        "action",
        "project_id",
        "request_id",
        "expected_revision",
        "master_ids",
        "adapter_id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "package_validate"
        },
        "project_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "request_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "authority_ref": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384
        },
        "package_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^pkg_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "expected_package_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "adapter_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
        }
      },
      "required": [
        "action",
        "project_id",
        "request_id",
        "expected_revision",
        "package_id",
        "expected_package_revision",
        "adapter_id"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "ArtifactRef": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^art_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "sha256": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "artifact_id",
        "sha256"
      ],
      "additionalProperties": false
    },
    "DocumentRef": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "brief",
            "brand",
            "timeline",
            "scene",
            "settings",
            "variants",
            "bindings",
            "caption",
            "caption_style",
            "delivery_profile",
            "gate_policy",
            "asset_library",
            "storyboard"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "kind",
        "id",
        "revision",
        "sha256"
      ],
      "additionalProperties": false
    },
    "SidecarRecord": {
      "type": "object",
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "role": {
          "const": "subtitles"
        },
        "variant": {
          "$ref": "#/$defs/DocumentRef"
        },
        "caption": {
          "$ref": "#/$defs/DocumentRef"
        },
        "placement": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "format": {
          "type": "string",
          "enum": [
            "srt",
            "vtt",
            "ass"
          ]
        },
        "time_origin": {
          "type": "string",
          "enum": [
            "source",
            "delivery"
          ]
        },
        "timing_receipt": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "artifact",
        "role",
        "variant",
        "caption",
        "placement",
        "language",
        "format",
        "time_origin",
        "timing_receipt"
      ],
      "additionalProperties": false
    },
    "RegisteredOptions": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  }
}
