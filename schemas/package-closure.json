{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "motion/v1/PackageClosure",
  "type": "object",
  "properties": {
    "schema": {
      "const": "motion/v1/package-closure"
    },
    "project_id": {
      "type": "string",
      "minLength": 0,
      "maxLength": 16384,
      "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "source_roots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "media_type": {
            "type": "string",
            "minLength": 0,
            "maxLength": 16384
          },
          "inputs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ArtifactRef"
            },
            "minItems": 0,
            "maxItems": 1000
          },
          "provenance": {
            "$ref": "#/$defs/Provenance"
          }
        },
        "required": [
          "artifact",
          "size_bytes",
          "media_type",
          "inputs",
          "provenance"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 1000
    }
  },
  "required": [
    "schema",
    "project_id",
    "source_roots",
    "artifacts"
  ],
  "additionalProperties": false,
  "$defs": {
    "ArtifactRef": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^art_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "sha256": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "artifact_id",
        "sha256"
      ],
      "additionalProperties": false
    },
    "Provenance": {
      "type": "object",
      "properties": {
        "origin": {
          "type": "string",
          "enum": [
            "user_import",
            "authored",
            "stock",
            "generated",
            "derived"
          ]
        },
        "acquired_at": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
        },
        "source_locator": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 16384
            },
            {
              "type": "null"
            }
          ]
        },
        "provider": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 16384
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 16384
            },
            {
              "type": "null"
            }
          ]
        },
        "model_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 16384
            },
            {
              "type": "null"
            }
          ]
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "deterministic": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "rights": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "known",
                "unknown",
                "restricted"
              ]
            },
            "license": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 16384
                },
                {
                  "type": "null"
                }
              ]
            },
            "attribution": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 16384
                },
                {
                  "type": "null"
                }
              ]
            },
            "evidence": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ArtifactRef"
              },
              "minItems": 0,
              "maxItems": 1000
            }
          },
          "required": [
            "status",
            "license",
            "attribution",
            "evidence"
          ],
          "additionalProperties": false
        },
        "notes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384
        }
      },
      "required": [
        "origin",
        "acquired_at",
        "source_locator",
        "provider",
        "model",
        "model_version",
        "seed",
        "deterministic",
        "rights",
        "notes"
      ],
      "additionalProperties": false
    }
  }
}
