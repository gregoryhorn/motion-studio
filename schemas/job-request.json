              "pattern": "^pln_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "plan_revision": {
              "const": 1
            },
            "plan_sha256": {
              "type": "string",
              "minLength": 0,
              "maxLength": 16384,
              "pattern": "^sha256:[0-9a-f]{64}$"
