      "required": [
        "action",
        "project_id",
        "request_id",
        "job_id",
        "expected_job_revision"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "handoff_claim"
        },
        "project_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "job_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^job_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "expected_job_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "handoff_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^hnd_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "attempt_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^att_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "action",
        "project_id",
        "request_id",
        "job_id",
