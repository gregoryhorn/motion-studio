      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "collect"
        },
        "project_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "job_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^job_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "expected_job_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "receipts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "handoff_id": {
                "type": "string",
                "minLength": 0,
                "maxLength": 16384,
                "pattern": "^hnd_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "attempt_id": {
                "type": "string",
                "minLength": 0,
                "maxLength": 16384,
                "pattern": "^att_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "request_sha256": {
                "type": "string",
                "minLength": 0,
                "maxLength": 16384,
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "host_call_ref": {
                "type": "string",
                "minLength": 0,
                "maxLength": 16384
              },
              "outcome": {
                "type": "string",
                "enum": [
                  "succeeded",
                  "failed",
                  "uncertain"
                ]
              },
              "outputs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "port": {
                      "type": "string",
                      "minLength": 0,
                      "maxLength": 16384
                    },
                    "locator": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "const": "local"
                            },
                            "path": {
                              "type": "string",
                              "minLength": 0,
                              "maxLength": 16384
                            }
                          },
                          "required": [
                            "kind",
                            "path"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "const": "remote"
                            },
                            "url": {
                              "type": "string",
                              "minLength": 0,
                              "maxLength": 16384
                            }
                          },
                          "required": [
                            "kind",
                            "url"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    }
                  },
                  "required": [
                    "port",
                    "locator"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0,
                "maxItems": 1000
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "artifact_id": {
                      "type": "string",
                      "minLength": 0,
                      "maxLength": 16384,
                      "pattern": "^art_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                    },
                    "sha256": {
                      "type": "string",
                      "minLength": 0,
                      "maxLength": 16384,
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "artifact_id",
                    "sha256"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0,
                "maxItems": 1000
              },
              "reported_at": {
                "type": "string",
                "minLength": 0,
                "maxLength": 16384,
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
              }
            },
            "required": [
              "handoff_id",
              "attempt_id",
              "request_sha256",
              "host_call_ref",
              "outcome",
              "outputs",
              "evidence",
              "reported_at"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 1000
        },
        "decision_review_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 16384,
            "pattern": "^rev_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "minItems": 0,
          "maxItems": 1000
        }
      },
      "required": [
        "action",
        "project_id",
        "request_id",
        "job_id",
        "expected_job_revision"
      ],
      "additionalProperties": false
    },
