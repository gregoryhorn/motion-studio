            "profile"
          ]
        },
        "job_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "pattern": "^job_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "action",
        "project_id",
        "plan",
        "node_id",
        "mode",
        "project_scope"
      ],
      "additionalProperties": false
