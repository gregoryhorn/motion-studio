{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "compatibility": {
      "additionalProperties": false,
      "properties": {
        "adapter_abis": {
          "items": {
            "minimum": 1,
            "type": "integer"
          },
          "maxItems": 32,
          "type": "array",
          "uniqueItems": true
        },
        "architectures": {
          "items": {
            "maxLength": 2048,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 256,
          "type": "array",
          "uniqueItems": true
        },
        "hermes": {
          "maxLength": 256,
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "plan_schemas": {
          "items": {
            "minimum": 1,
            "type": "integer"
          },
          "maxItems": 32,
          "type": "array",
          "uniqueItems": true
        },
        "platforms": {
          "items": {
            "maxLength": 2048,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 256,
          "type": "array",
          "uniqueItems": true
        },
        "project_schemas": {
          "items": {
            "minimum": 1,
            "type": "integer"
          },
          "maxItems": 32,
          "type": "array",
          "uniqueItems": true
        },
        "python": {
          "maxLength": 256,
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "tested_host_revisions": {
          "items": {
            "pattern": "^[0-9a-f]{40}$",
            "type": "string"
          },
          "maxItems": 256,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "platforms",
        "architectures",
        "python",
        "hermes",
        "tested_host_revisions",
        "adapter_abis",
        "project_schemas",
        "plan_schemas"
      ],
      "type": "object"
    },
    "packs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "compatibility": {
            "maxLength": 256,
            "minLength": 1,
            "type": [
              "string",
              "null"
            ]
          },
          "dependencies": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "constraint": {
                  "maxLength": 256,
                  "minLength": 1,
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "delivery": {
                  "enum": [
                    "bundled",
                    "existing",
                    "download"
                  ]
                },
                "identifier": {
                  "maxLength": 2048,
                  "minLength": 1,
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "python",
                    "executable",
                    "resource",
                    "model"
                  ]
                },
                "notices": {
                  "items": {
                    "maxLength": 2048,
                    "minLength": 1,
                    "type": "string"
                  },
                  "maxItems": 256,
                  "type": "array",
                  "uniqueItems": true
                },
                "sha256": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "size": {
                  "maximum": 67108864,
                  "minimum": 0,
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "source": {
                  "maxLength": 256,
                  "minLength": 1,
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "verification": {
                  "enum": [
                    "native-python",
                    "sha256",
                    "binding-discovery"
                  ]
                }
              },
              "required": [
                "kind",
                "identifier",
                "constraint",
                "source",
                "sha256",
                "size",
                "verification",
                "delivery",
                "notices"
              ],
              "type": "object"
            },
            "maxItems": 256,
            "type": "array"
          },
          "id": {
            "pattern": "^[a-z][a-z0-9-]{0,63}$",
            "type": "string"
          },
          "operations": {
            "items": {
              "maxLength": 2048,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 256,
            "type": "array",
            "uniqueItems": true
          },
          "platforms": {
            "items": {
              "maxLength": 2048,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 256,
            "type": "array",
            "uniqueItems": true
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "required",
          "platforms",
          "operations",
          "compatibility",
          "dependencies"
        ],
        "type": "object"
      },
      "maxItems": 256,
      "type": "array"
    },
    "payload": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "mode": {
            "maximum": 511,
            "minimum": 0,
            "type": "integer"
          },
          "path": {
            "maxLength": 2048,
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "size": {
            "maximum": 67108864,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "path",
          "size",
          "sha256",
          "mode"
        ],
        "type": "object"
      },
      "maxItems": 10000,
      "type": "array"
    },
    "plugin_id": {
      "const": "motion-studio"
    },
    "qualification": {
      "enum": [
        "unqualified-development",
        "qualified"
      ]
    },
    "schema": {
      "const": "motion/studio-manifest/v1"
    },
    "storage": {
      "additionalProperties": false,
      "properties": {
        "migration": {
          "const": "none"
        },
        "readable": {
          "items": {
            "minimum": 1,
            "type": "integer"
          },
          "maxItems": 32,
          "type": "array",
          "uniqueItems": true
        },
        "writable": {
          "items": {
            "minimum": 1,
            "type": "integer"
          },
          "maxItems": 32,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "readable",
        "writable",
        "migration"
      ],
      "type": "object"
    },
    "version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.-]+)?$",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "plugin_id",
    "version",
    "qualification",
    "compatibility",
    "payload",
    "packs",
    "storage"
  ],
  "title": "Motion Studio shared release/pack manifest",
  "type": "object"
}
